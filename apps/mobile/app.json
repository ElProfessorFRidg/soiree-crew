{
  "expo": {
    "name": "Soirée Crew",
    "slug": "soiree-crew",
    "scheme": "soireecrew",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#1E2624",
    "ios": {
      "bundleIdentifier": "app.soireecrew.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [],
        "CFBundleAllowMixedLocalizations": true,
        "CADisableMinimumFrameDurationOnPhone": true,
        "RCTAsyncStorageExcludeFromBackup": true
      }
    },
    "android": {
      "package": "app.soireecrew.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#1E2624",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Archivo-Numeral.ttf",
            "./assets/fonts/Archivo-Title.ttf",
            "./assets/fonts/Archivo-Heading.ttf",
            "./assets/fonts/Archivo-Body.ttf",
            "./assets/fonts/Archivo-Medium.ttf",
            "./assets/fonts/Archivo-Semibold.ttf",
            "./assets/fonts/Archivo-Tag.ttf",
            "./assets/fonts/Archivo-Bold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E2624",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false,
          "color": "#F4B33D"
        }
      ],
      "expo-secure-store",
      "expo-live-activity",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used to check in at a bar with your crew, and to share it during a party if you turn that on. It is checked, then deleted.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Your photos fill the party album, seen by your crew only. Their location is removed.",
          "cameraPermission": "The camera takes photos for the party album and your chats, and scans a friend's safety code. Photos are seen only by the people you share them with."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Voice notes in your chats use the microphone, only while you record one. They are encrypted on your phone before they are sent."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "The calendar gets the parties you add to it, nothing else is read.",
          "remindersPermission": false
        }
      ],
      [
        "expo-quick-actions/icon/plugin",
        {
          "boss": {
            "image": "./assets/icons/icon-boss.png"
          },
          "globetrotter": {
            "image": "./assets/icons/icon-globetrotter.png"
          },
          "nomad": {
            "image": "./assets/icons/icon-nomad.png"
          },
          "winter": {
            "image": "./assets/icons/icon-winter.png"
          },
          "spring": {
            "image": "./assets/icons/icon-spring.png"
          },
          "summer": {
            "image": "./assets/icons/icon-summer.png"
          },
          "autumn": {
            "image": "./assets/icons/icon-autumn.png"
          }
        }
      ],
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "The camera takes photos for the party album and your chats, and scans a friend's safety code. Photos are seen only by the people you share them with.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Night",
              "label": "Soirée Crew",
              "description": "Back to zero and one-tap buttons for tonight.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetCategory": "home_screen|keyguard"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "locales": {
      "fr": "./locales/fr.json",
      "en": "./locales/en.json",
      "es": "./locales/es.json",
      "it": "./locales/it.json",
      "de": "./locales/de.json",
      "pt": "./locales/pt.json",
      "ru": "./locales/ru.json"
    }
  }
}
